# =============================================================================
# iHRP Function List Tracker — .env template
# =============================================================================
# Copy file này sang `.env` (đã có sẵn trong .gitignore, KHÔNG commit lên repo):
#     cp .env.example .env
#
# Sau đó điền username/password theo prefix của mỗi integration đã tạo trong
# UI "🔌 API Registry".
#
# Rule tên biến:
#   <PREFIX>_USERNAME
#   <PREFIX>_PASSWORD
# Trong đó <PREFIX> = giá trị 'credential_env' bạn nhập khi tạo integration.
# Chỉ dùng ký tự A-Z, 0-9, _ (tự uppercase khi resolve).
#
# Value có thể quote bằng '...' hoặc "..." nếu chứa ký tự đặc biệt.
# Không quote nếu password chỉ có ASCII an toàn.
# =============================================================================

# --- Example: iHRP Production ---
# Với integration có credential_env = IHRP_PROD:
IHRP_PROD_USERNAME=your_prod_username
IHRP_PROD_PASSWORD=your_prod_password

# --- Example: iHRP UAT ---
# IHRP_UAT_USERNAME=uat_user
# IHRP_UAT_PASSWORD="uat pass with spaces"

# --- Example: Workload Report (báo cáo workload từ 1 hệ thống khác) ---
# WORKLOAD_USERNAME=abc
# WORKLOAD_PASSWORD=xyz

# --- Example: GAP List Tracker ---
# GAP_TRACKER_USERNAME=abc
# GAP_TRACKER_PASSWORD=xyz
