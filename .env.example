# =============================================================================
# iHRP Function List Tracker — .env template
# =============================================================================
# Copy file này sang `.env` (đã có sẵn trong .gitignore, KHÔNG commit lên repo):
#     cp .env.example .env
#
# Sau đó điền credential theo prefix của mỗi integration đã tạo trong UI
# "🔌 API Registry" → tab "Thêm mới / Chỉnh sửa".
#
# QUY TẮC ĐẶT TÊN BIẾN — 4 auth methods:
# -----------------------------------------------------------------------------
# 1) form_login  →  <PREFIX>_USERNAME, <PREFIX>_PASSWORD
#      PREFIX = giá trị 'credential_env' bạn nhập khi tạo integration.
#
# 2) basic_auth  →  <PREFIX>_USERNAME, <PREFIX>_PASSWORD
#      PREFIX = giá trị 'credential_env' (tái sử dụng key với form_login).
#      Backend sẽ tự encode base64(user:pass) rồi gửi header
#      Authorization: Basic <b64>.
#
# 3) bearer_token →  <PREFIX>_TOKEN
#      PREFIX = giá trị 'bearer_env' bạn nhập khi tạo integration.
#      Backend gửi header Authorization: Bearer <token>.
#
# 4) api_key     →  <PREFIX>_KEY
#      PREFIX = giá trị 'apikey_env'. Header name + vị trí (header|query)
#      được config trong UI, KHÔNG lưu trong .env.
#
# Chỉ dùng ký tự A-Z, 0-9, _ trong PREFIX (tự uppercase khi resolve).
# Value có thể quote bằng '...' hoặc "..." nếu chứa ký tự đặc biệt.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) form_login — iHRP Production
# Ứng dụng nguồn có form đăng nhập HTML (username/password) → export .xlsx.
# Integration credential_env = IHRP_PROD.
# -----------------------------------------------------------------------------
IHRP_PROD_USERNAME=your_prod_username
IHRP_PROD_PASSWORD=your_prod_password

# --- iHRP UAT (cùng credential prefix pattern) ---
# IHRP_UAT_USERNAME=uat_user
# IHRP_UAT_PASSWORD="uat pass with spaces"


# -----------------------------------------------------------------------------
# 2) basic_auth — REST API dùng HTTP Basic
# Integration credential_env = FIS_UAT.
# -----------------------------------------------------------------------------
# FIS_UAT_USERNAME=fis_svc_account
# FIS_UAT_PASSWORD=super_secret


# -----------------------------------------------------------------------------
# 3) bearer_token — REST API với JWT / Personal Access Token
# Integration bearer_env = FIS_API → biến FIS_API_TOKEN.
# Ví dụ: sau khi team FIS release REST API chính thức, họ cấp token dài hạn.
# -----------------------------------------------------------------------------
# FIS_API_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxx.yyy


# -----------------------------------------------------------------------------
# 4) api_key — REST API với header X-API-Key hoặc query ?api_key=xxx
# Integration apikey_env = FIS_API → biến FIS_API_KEY.
# Header name + location (header|query) được config trong UI.
# -----------------------------------------------------------------------------
# FIS_API_KEY=sk-abc-1234567890


# -----------------------------------------------------------------------------
# Các integration khác (workload report, GAP list…) tuân theo cùng pattern:
# -----------------------------------------------------------------------------
# WORKLOAD_USERNAME=abc
# WORKLOAD_PASSWORD=xyz
# GAP_TRACKER_TOKEN=jwt-xxx
